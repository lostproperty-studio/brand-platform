# --- Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App
NEXT_PUBLIC_APP_URL=https://brand.lostproperty.studio
# Optional: 32 random bytes, base64 (openssl rand -base64 32). Encrypts clients' AI keys at rest.
# If unset, a key is derived from SUPABASE_JWT_SECRET (added by the Vercel Supabase integration).
KEY_ENCRYPTION_SECRET=
# Comma-separated email domains allowed to sign in as studio staff
STUDIO_EMAIL_DOMAINS=lostproperty.studio

# --- Figma (studio account → Settings → Security → Personal access tokens, scope: file_content:read)
FIGMA_TOKEN=

# --- Anthropic: the STUDIO key, used only for scanning Figma files (studio work).
# Client chat and Canvas use each client's own key, stored per project.
ANTHROPIC_API_KEY=

# --- GitHub App (creates one kit repository per project)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=lostproperty-studio
